#!/usr/bin/env python3
"""Plan/apply tagged RHEL 9 VMs, grant private vLLM access, or inspect AWS read-only.

Requires AWS CLI v2 and its normal credential chain. Never accepts access keys
as arguments. Creates only a key-pair import, security group, instance and root
disk; no IAM, VPC, DNS, gateway deployment or deletion. Apply is never implicit.
"""
import argparse
from contextlib import contextmanager, nullcontext
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import uuid

OWNER = "309956199498"
MANAGED = "secure-single-server-test"
SCENARIOS = ("all-in-one", "remote-gateway", "openshell-praxis", "vllm-server")
VLLM_PORT = 8000
CONFIG_KEYS = {"scenario", "inference", "arch", "instance_type", "volume_gib", "ami_id", "ssh_access", "https_access"}
READS = {"get-caller-identity", "describe-instance-types", "describe-images", "describe-subnets",
         "describe-route-tables", "describe-instances", "describe-security-groups", "describe-volumes",
         "describe-key-pairs", "describe-instance-type-offerings"}
WRITES = {"import-key-pair", "create-security-group", "authorize-security-group-ingress", "run-instances"}


class AwsError(ValueError):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


class Aws:
    def __init__(self, region, profile, apply):
        self.region, self.profile, self.apply = region, profile, apply

    def call(self, service, action, **options):
        if action not in READS and (not self.apply or action not in WRITES):
            raise ValueError("AWS operation refused by mode/allowlist: " + action)
        command = ["aws", "--no-cli-pager", "--region", self.region, "--output", "json"]
        if self.profile:
            command += ["--profile", self.profile]
        command += [service, action]
        for key, value in options.items():
            if isinstance(value, bool):
                command += ["--" + ("" if value else "no-") + key.replace("_", "-")]
                continue
            command += ["--" + key.replace("_", "-")]
            if isinstance(value, (dict, list)):
                command += [json.dumps(value)]
            else:
                command += [str(value)]
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode:
            # AWS errors may echo request material. Never dump credential chain,
            # debug output or full request arguments into evidence.
            match = re.search(r"\(([A-Za-z0-9_.]+)\)", result.stderr)
            code = match.group(1) if match else "CLI error"
            if code == "InsufficientInstanceCapacity":
                raise AwsError(code, f"AWS {action} failed ({code}); insufficient On-Demand capacity in the selected "
                                 "Availability Zone. Inspect the recovery journal before retrying; wait or choose "
                                 "another public subnet. See docs/testing/aws-operations.md#capacity-errors")
            raise AwsError(code, f"AWS {action} failed ({code}); check region, credentials and permissions")
        return json.loads(result.stdout or "{}")


def ingress(scenario, cidr, ssh_access="restricted", https_access="restricted"):
    if scenario not in SCENARIOS:
        raise ValueError("unknown VM scenario: " + scenario)
    if ssh_access not in ("restricted", "public"):
        raise ValueError("ssh_access must be restricted or public")
    if https_access not in ("restricted", "public"):
        raise ValueError("https_access must be restricted or public")
    if https_access == "public" and scenario != "remote-gateway":
        raise ValueError("public HTTPS is only available for remote-gateway")
    needs_cidr = ssh_access == "restricted" or (scenario == "remote-gateway" and https_access == "restricted")
    if needs_cidr and not cidr:
        raise ValueError("--allowed-cidr is required for restricted SSH or HTTPS")
    if cidr:
        network = ipaddress.ip_network(cidr, strict=True)
        if network.version != 4 or network.prefixlen != 32:
            raise ValueError("allowed-cidr must be one IPv4 /32; use --ssh-access/--https-access public for public access")
        cidr = str(network)
    ports = [(22, ssh_access)]
    if scenario == "remote-gateway":
        ports.append((8443, https_access))
    return [{"IpProtocol": "tcp", "FromPort": port, "ToPort": port,
             "IpRanges": [{"CidrIp": "0.0.0.0/0" if access == "public" else cidr}]}
            for port, access in ports]


def validate_image(image, architecture):
    if (image.get("OwnerId") != OWNER or image.get("Architecture") != architecture
            or image.get("State") != "available" or image.get("RootDeviceType") != "ebs"
            or not re.fullmatch(r"RHEL-9\..*Hourly2-GP3", image.get("Name", ""))):
        raise ValueError("AMI must be an official Red Hat RHEL 9 PAYG GP3 image matching the instance architecture")
    disks = image.get("BlockDeviceMappings", [])
    if (len(disks) != 1 or disks[0].get("DeviceName") != image.get("RootDeviceName")
            or "Ebs" not in disks[0]):
        raise ValueError("AMI must define only one EBS root disk; additional image disks are not supported")


def write_state(output, state):
    json.dump(state, output, indent=2)
    output.write("\n")
    output.flush()
    os.fsync(output.fileno())


def save_state(path, state):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as output:
        write_state(output, state)


def update_state(path, state):
    # Preserve the previous recovery record if writing its successor fails.
    fd, temporary = tempfile.mkstemp(prefix="." + path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            write_state(output, state)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def tags(prefix, scenario):
    return [{"Key": "ManagedBy", "Value": MANAGED}, {"Key": "ResourcePrefix", "Value": prefix},
            {"Key": "Scenario", "Value": scenario}, {"Key": "Name", "Value": prefix}]


def filters(**values):
    return [{"Name": key, "Values": [value]} for key, value in values.items()]


def check_identity(aws, account):
    identity = aws.call("sts", "get-caller-identity")
    if identity["Account"] != account or identity["Arn"].endswith(":root"):
        raise ValueError("wrong AWS account or root-account credentials; no changes made")
    return identity


def owned_tags(instance, prefix, scenario):
    actual = {item["Key"]: item["Value"] for item in instance.get("Tags", [])}
    expected = {item["Key"]: item["Value"] for item in tags(prefix, scenario)}
    return all(actual.get(key) == value for key, value in expected.items())


def vllm_instances(aws, args):
    query = filters(**{"tag:ManagedBy": MANAGED, "tag:Scenario": "vllm-server",
                       "instance-state-name": "running"})
    if args.vllm_instance_id:
        if args.vllm_prefix:
            raise ValueError("choose either --vllm-instance-id or --vllm-prefix, not both")
        if not re.fullmatch(r"i-[0-9a-f]+", args.vllm_instance_id):
            raise ValueError("vllm-instance-id must be an EC2 instance ID")
        response = aws.call("ec2", "describe-instances", instance_ids=[args.vllm_instance_id],
                            filters=query)
        return [instance for reservation in response["Reservations"]
                for instance in reservation.get("Instances", [])]
    if not args.vllm_prefix or not re.fullmatch(r"[a-z][a-z0-9-]{2,39}", args.vllm_prefix):
        raise ValueError("vllm-prefix must be the complete 3-40 character resource prefix")
    response = aws.call("ec2", "describe-instances", filters=query + filters(
        **{"tag:ResourcePrefix": args.vllm_prefix}))
    return [instance for reservation in response["Reservations"]
            for instance in reservation.get("Instances", [])]


def check_no_public_vllm_ingress(groups):
    private_networks = (ipaddress.ip_network("10.0.0.0/8"),
                        ipaddress.ip_network("172.16.0.0/12"),
                        ipaddress.ip_network("192.168.0.0/16"),
                        ipaddress.ip_network("fc00::/7"))
    for group in groups:
        for permission in group.get("IpPermissions", []):
            protocol = permission.get("IpProtocol")
            if protocol == "-1":
                port_matches = True
            elif protocol == "tcp":
                port_matches = int(permission.get("FromPort", 0)) <= VLLM_PORT <= int(permission.get("ToPort", 65535))
            else:
                continue
            if not port_matches:
                continue
            if permission.get("PrefixListIds"):
                raise ValueError("vLLM security group exposes port 8000 through a prefix list")
            ranges = [item.get("CidrIp") for item in permission.get("IpRanges", [])]
            ranges += [item.get("CidrIpv6") for item in permission.get("Ipv6Ranges", [])]
            for cidr in filter(None, ranges):
                network = ipaddress.ip_network(cidr, strict=False)
                if not any(network.version == space.version and network.subnet_of(space)
                           for space in private_networks):
                    raise ValueError("vLLM security group exposes port 8000 to the Internet")


def check_vllm_ingress_is_source_group_only(groups):
    source_group_rule = False
    for group in groups:
        for permission in group.get("IpPermissions", []):
            protocol = permission.get("IpProtocol")
            if protocol == "-1":
                port_matches = True
            elif protocol == "tcp":
                port_matches = int(permission.get("FromPort", 0)) <= VLLM_PORT <= int(permission.get("ToPort", 65535))
            else:
                continue
            if not port_matches:
                continue
            if (permission.get("IpRanges") or permission.get("Ipv6Ranges")
                    or permission.get("PrefixListIds") or not permission.get("UserIdGroupPairs")):
                raise ValueError("vLLM port 8000 ingress must use source security groups")
            if (protocol != "tcp" or permission.get("FromPort") != VLLM_PORT
                    or permission.get("ToPort") != VLLM_PORT):
                raise ValueError("vLLM port 8000 ingress must be an exact TCP source-group rule")
            source_group_rule = True
    if not source_group_rule:
        raise ValueError("vLLM security group has no source-group access on port 8000")


def vllm_endpoint(aws, args):
    check_identity(aws, args.account_id)
    instances = vllm_instances(aws, args)
    if len(instances) != 1:
        raise ValueError(f"expected exactly one running tagged vLLM instance, found {len(instances)}")
    instance = instances[0]
    actual_tags = {item["Key"]: item["Value"] for item in instance.get("Tags", [])}
    if actual_tags.get("ManagedBy") != MANAGED or actual_tags.get("Scenario") != "vllm-server":
        raise ValueError("instance ownership/scenario tags do not match")
    private_ip = instance.get("PrivateIpAddress")
    if not private_ip:
        raise ValueError("vLLM instance has no private IPv4 address yet; wait and rerun")
    if not args.client_vpc_id:
        raise ValueError("client VPC is required for vLLM endpoint discovery")
    if args.client_vpc_id and instance.get("VpcId") != args.client_vpc_id:
        raise ValueError("vLLM instance is not in the single server's VPC")
    group_ids = [group["GroupId"] for group in instance.get("SecurityGroups", [])]
    groups = aws.call("ec2", "describe-security-groups", group_ids=group_ids)["SecurityGroups"] if group_ids else []
    check_vllm_ingress_is_source_group_only(groups)
    result = {"InstanceId": instance["InstanceId"], "PrivateIpAddress": private_ip,
              "VllmEndpoint": f"{private_ip}:{VLLM_PORT}", "VpcId": instance.get("VpcId"),
              "SecurityGroupIds": group_ids, "Result": "private vLLM endpoint discovered"}
    print(json.dumps(result, indent=2))


def launch_state(path, args, scenario=None):
    state = json.loads(path.read_text())
    if not isinstance(state, dict):
        raise ValueError("incomplete launch journal; expected a JSON object")
    required = {"AccountId", "Region", "Scenario", "Prefix", "InstanceId",
                "SecurityGroupId", "Ingress"}
    if not required <= state.keys():
        raise ValueError("incomplete launch journal; run verify and inspect the VM first")
    if state["AccountId"] != args.account_id or state["Region"] != args.region:
        raise ValueError("state file account/region does not match the explicitly selected target")
    if scenario and state["Scenario"] != scenario:
        raise ValueError("state file scenario does not match " + scenario)
    return state


def described_instance(aws, state, scenario):
    response = aws.call("ec2", "describe-instances", instance_ids=[state["InstanceId"]])
    instances = [instance for reservation in response.get("Reservations", [])
                 for instance in reservation.get("Instances", [])]
    if len(instances) != 1:
        raise ValueError("launch-journal instance was not found")
    instance = instances[0]
    if instance["State"]["Name"] != "running" or not owned_tags(instance, state["Prefix"], scenario):
        raise ValueError("launch-journal instance is not running or its ownership tags changed")
    if [group["GroupId"] for group in instance["SecurityGroups"]] != [state["SecurityGroupId"]]:
        raise ValueError("unexpected attached security groups")
    return instance


def source_group_grant_exists(group, source_group_id):
    for permission in group.get("IpPermissions", []):
        protocol = permission.get("IpProtocol")
        if protocol == "tcp":
            port_matches = (permission.get("FromPort") == VLLM_PORT and
                            permission.get("ToPort") == VLLM_PORT)
        else:
            continue
        if not port_matches:
            continue
        pairs = permission.get("UserIdGroupPairs", [])
        if (any(item.get("GroupId") == source_group_id for item in pairs)
                and not permission.get("IpRanges") and not permission.get("Ipv6Ranges")
                and not permission.get("PrefixListIds")):
            return True
    return False


def validate_vllm_grant_state(aws, vllm_state, client_security_group_id):
    groups = aws.call(
        "ec2",
        "describe-security-groups",
        group_ids=[vllm_state["SecurityGroupId"]],
    )["SecurityGroups"]
    if len(groups) != 1 or not owned_tags(groups[0], vllm_state["Prefix"], "vllm-server"):
        raise ValueError("vLLM security-group ownership/scenario tags do not match")

    group = groups[0]
    existing = source_group_grant_exists(group, client_security_group_id)
    validation_state = vllm_state
    if existing and client_security_group_id not in vllm_state.get("ManagedGrants", []):
        validation_state = {
            **vllm_state,
            "ManagedGrants": [
                *vllm_state.get("ManagedGrants", []),
                client_security_group_id,
            ],
        }

    check_ingress(group, validation_state)
    check_no_public_vllm_ingress(groups)
    return group, existing


def vllm_grant(aws, args):
    check_identity(aws, args.account_id)
    client_state = launch_state(args.client_state_file, args)
    vllm_state = launch_state(args.vllm_state_file, args, "vllm-server")
    if client_state["Scenario"] == "vllm-server":
        raise ValueError("client state must describe the single server, not the vLLM server")
    client = described_instance(aws, client_state, client_state["Scenario"])
    vllm = described_instance(aws, vllm_state, "vllm-server")
    if client.get("VpcId") != vllm.get("VpcId"):
        raise ValueError("single server and vLLM server must be in the same VPC")
    group, existing = validate_vllm_grant_state(aws, vllm_state, client_state["SecurityGroupId"])
    proposal = {"ClientInstanceId": client["InstanceId"], "VllmInstanceId": vllm["InstanceId"],
                "ClientSecurityGroupId": client_state["SecurityGroupId"],
                "VllmSecurityGroupId": vllm_state["SecurityGroupId"], "Port": VLLM_PORT,
                "Exists": existing, "VpcId": client["VpcId"]}
    print(json.dumps(proposal, indent=2))
    if existing:
        print("Private vLLM access already granted; no AWS resource changed.")
        if args.apply:
            record_vllm_grant(vllm_state, args, client_state["SecurityGroupId"])
        return
    if not args.apply:
        print("Read-only grant plan complete: no AWS resource was changed.")
        return
    confirmation = f"grant {args.account_id} {args.region} {vllm_state['SecurityGroupId']} {client_state['SecurityGroupId']}"
    if input("Billable-free security-group rule. Type exactly '" + confirmation + "': ") != confirmation:
        raise ValueError("confirmation did not match; no changes made")
    aws.apply = True
    group, existing = validate_vllm_grant_state(aws, vllm_state, client_state["SecurityGroupId"])
    if existing:
        print("Private vLLM access already granted; no AWS resource changed.")
        record_vllm_grant(vllm_state, args, client_state["SecurityGroupId"])
        return
    try:
        aws.call("ec2", "authorize-security-group-ingress", group_id=vllm_state["SecurityGroupId"],
                 ip_permissions=[{"IpProtocol": "tcp", "FromPort": VLLM_PORT, "ToPort": VLLM_PORT,
                                  "UserIdGroupPairs": [{"GroupId": client_state["SecurityGroupId"],
                                                        "Description": "secure-single-server Praxis client"}]}])
    except AwsError as error:
        if error.code != "InvalidPermission.Duplicate":
            raise
        validate_vllm_grant_state(aws, vllm_state, client_state["SecurityGroupId"])
    record_vllm_grant(vllm_state, args, client_state["SecurityGroupId"])
    print("Granted private TCP 8000 access from the single server security group.")


def record_vllm_grant(state, args, client_security_group_id):
    grants = state.setdefault("ManagedGrants", [])
    if client_security_group_id not in grants:
        grants.append(client_security_group_id)
        update_state(args.vllm_state_file, state)


def configure(args):
    """Data-only config, then explicit CLI overrides; never source shell code."""
    settings = {}
    if args.config:
        settings = json.loads(args.config.read_text())
        if not isinstance(settings, dict) or set(settings) - CONFIG_KEYS:
            raise ValueError("VM config must be an object containing only: " + ", ".join(sorted(CONFIG_KEYS)))
        for key, value in settings.items():
            expected = int if key == "volume_gib" else str
            if type(value) is not expected:
                raise ValueError("invalid VM config type for " + key)
    for key in CONFIG_KEYS:
        value = getattr(args, key)
        if value is not None:
            settings[key] = value
    inference = settings.setdefault("inference", "none")
    arch = settings.setdefault("arch", "amd64")
    if settings.setdefault("ssh_access", "restricted") not in ("restricted", "public"):
        raise ValueError("ssh_access must be restricted or public")
    if settings.setdefault("https_access", "restricted") not in ("restricted", "public"):
        raise ValueError("https_access must be restricted or public")
    if settings["https_access"] == "public" and settings.get("scenario") != "remote-gateway":
        raise ValueError("public HTTPS is only available for remote-gateway")
    if inference not in ("none", "cpu", "gpu") or arch not in ("amd64", "arm64"):
        raise ValueError("inference must be none/cpu/gpu and arch must be amd64/arm64")
    if settings.get("scenario") not in SCENARIOS:
        raise ValueError("set scenario to all-in-one, remote-gateway, openshell-praxis or vllm-server")
    if settings.get("scenario") == "vllm-server" and inference == "none":
        raise ValueError("vllm-server requires the cpu or gpu inference hardware profile")
    if inference != "none" and arch != "amd64":
        raise ValueError("the pinned vLLM CPU/GPU profiles require amd64")
    minimum = {"none": 50, "cpu": 100, "gpu": 200}[inference]
    settings.setdefault("volume_gib", minimum)
    if not minimum <= settings["volume_gib"] <= 16384:
        raise ValueError(f"{inference} inference requires a {minimum}-16384 GiB root disk")
    settings.setdefault("instance_type", {"cpu": "m7i.4xlarge", "gpu": "g6.2xlarge"}.get(
        inference, "m7g.2xlarge" if arch == "arm64" else "m7i.2xlarge"))
    if not re.fullmatch(r"[a-z0-9-]+\.[a-z0-9-]+", settings["instance_type"]):
        raise ValueError("invalid instance_type")
    if "ami_id" in settings and not re.fullmatch(r"ami-[0-9a-f]+", settings["ami_id"]):
        raise ValueError("invalid ami_id")
    for key, value in settings.items():
        setattr(args, key, value)


def validate_machine(machine, architecture, inference):
    if (machine["MemoryInfo"]["SizeInMiB"] < 32768
            or architecture not in machine["ProcessorInfo"]["SupportedArchitectures"]):
        raise ValueError("instance must have at least 32 GiB RAM and match --arch")
    if inference == "gpu":
        gpus = machine.get("GpuInfo", {}).get("Gpus", [])
        if (len(gpus) != 1 or gpus[0].get("Name") != "L4"
                or gpus[0].get("Manufacturer", "").lower() != "nvidia"
                or gpus[0].get("Count") != 1 or gpus[0].get("GpuPartitionSize", 1) != 1
                or gpus[0].get("MemoryInfo", {}).get("SizeInMiB", 0) < 22000):
            raise ValueError("the pinned vLLM GPU profile requires exactly one full NVIDIA L4; choose g6.2xlarge or a compatible size")


def check_offering(aws, instance_type, zone):
    offerings = aws.call("ec2", "describe-instance-type-offerings", location_type="availability-zone",
                         filters=filters(**{"instance-type": instance_type, "location": zone}))
    if not offerings["InstanceTypeOfferings"]:
        raise ValueError(f"{instance_type} is not offered in {zone}; choose another approved public subnet or instance type")


def capacity_report(aws, args):
    """Read placement candidates; EC2 offerings do not report spare capacity."""
    check_identity(aws, args.account_id)
    selected = aws.call("ec2", "describe-subnets", subnet_ids=[args.subnet_id])["Subnets"][0]
    if selected["OwnerId"] != args.account_id:
        raise ValueError("selected subnet must belong to the expected account")
    offerings = aws.call("ec2", "describe-instance-type-offerings", location_type="availability-zone",
                         filters=filters(**{"instance-type": args.instance_type}))["InstanceTypeOfferings"]
    zones = sorted({item["Location"] for item in offerings})
    subnets = aws.call("ec2", "describe-subnets", filters=filters(
        **{"vpc-id": selected["VpcId"], "owner-id": args.account_id, "state": "available"}))["Subnets"]
    tables = aws.call("ec2", "describe-route-tables", filters=filters(
        **{"vpc-id": selected["VpcId"]}))["RouteTables"]
    candidates = []
    for subnet in subnets:
        if subnet["AvailabilityZone"] not in zones or subnet["AvailableIpAddressCount"] < 1:
            continue
        routes = [table for table in tables if any(association.get("SubnetId") == subnet["SubnetId"]
                  for association in table.get("Associations", []))]
        if not routes:
            routes = [table for table in tables if any(association.get("Main")
                      for association in table.get("Associations", []))]
        if any(route.get("DestinationCidrBlock") == "0.0.0.0/0"
               and route.get("GatewayId", "").startswith("igw-") and route.get("State") == "active"
               for table in routes for route in table["Routes"]):
            candidates.append({"SubnetId": subnet["SubnetId"], "AvailabilityZone": subnet["AvailabilityZone"],
                               "AvailableIpAddresses": subnet["AvailableIpAddressCount"]})
    return {"AccountId": args.account_id, "Region": aws.region, "InstanceType": args.instance_type,
            "SelectedSubnetId": args.subnet_id, "SelectedAvailabilityZone": selected["AvailabilityZone"],
            "VpcId": selected["VpcId"], "OfferedInAvailabilityZones": zones,
            "PublicSubnetCandidates": sorted(candidates, key=lambda item: (item["AvailabilityZone"], item["SubnetId"])),
            "SpareInstanceCapacity": "unknown",
            "Result": "Read-only placement report, not a capacity reservation. Subnet IP counts are not free EC2 instances. "
                      "No launch, dry-run launch, resource change or journal write was attempted."}


def plan(aws, args):
    try:
        key = args.public_key.read_text()
    except OSError as error:
        raise ValueError(f"Missing or unreadable public key: {args.public_key}. "
                         "Run aws_test_key before aws_test_plan, or supply an existing --public-key.") from error
    if "PRIVATE KEY" in key or len(key.strip().splitlines()) != 1:
        raise ValueError("provide one OpenSSH public key, never the private key")
    subprocess.run(["ssh-keygen", "-lf", str(args.public_key)], check=True, capture_output=True)
    if key.split()[0] not in ("ssh-ed25519", "ssh-rsa"):
        raise ValueError("EC2 key import supports an Ed25519 or RSA public key")
    rules = ingress(args.scenario, args.allowed_cidr, args.ssh_access, args.https_access)
    identity = check_identity(aws, args.account_id)
    instance_type = args.instance_type or ("m7g.2xlarge" if args.arch == "arm64" else "m7i.2xlarge")
    machine = aws.call("ec2", "describe-instance-types", instance_types=[instance_type])["InstanceTypes"][0]
    architecture = "arm64" if args.arch == "arm64" else "x86_64"
    validate_machine(machine, architecture, args.inference)
    image_filters = filters(name=f"RHEL-9.*_HVM-*-{architecture}-*-Hourly2-GP3",
                            architecture=architecture, state="available")
    images = aws.call("ec2", "describe-images", owners=[OWNER], filters=image_filters)["Images"]
    if args.ami_id:
        images = [image for image in images if image["ImageId"] == args.ami_id]
    if not images:
        raise ValueError("no matching official RHEL 9 image; inspect available AMIs in this region")
    image = max(images, key=lambda item: item["CreationDate"])
    validate_image(image, architecture)
    subnet = aws.call("ec2", "describe-subnets", subnet_ids=[args.subnet_id])["Subnets"][0]
    if subnet["State"] != "available":
        raise ValueError("subnet is not available")
    check_offering(aws, instance_type, subnet["AvailabilityZone"])
    tables = aws.call("ec2", "describe-route-tables",
                      filters=filters(**{"association.subnet-id": args.subnet_id}))["RouteTables"]
    if not tables:
        tables = aws.call("ec2", "describe-route-tables", filters=filters(
            **{"vpc-id": subnet["VpcId"], "association.main": "true"}))["RouteTables"]
    if not any(route.get("DestinationCidrBlock") == "0.0.0.0/0"
               and route.get("GatewayId", "").startswith("igw-") and route.get("State") == "active"
               for table in tables for route in table["Routes"]):
        raise ValueError("selected subnet must have an active IPv4 internet-gateway route")
    active = aws.call("ec2", "describe-instances", filters=[
        {"Name": "tag:ResourcePrefix", "Values": [args.prefix]},
        {"Name": "instance-state-name", "Values": ["pending", "running", "stopping", "stopped"]}])
    if any(row["Instances"] for row in active["Reservations"]):
        raise ValueError("an active VM already uses this prefix; verify it instead of launching again")
    groups = aws.call("ec2", "describe-security-groups", filters=filters(
        **{"vpc-id": subnet["VpcId"], "group-name": args.prefix}))["SecurityGroups"]
    if groups:
        raise ValueError("security-group name already exists; inspect partial resources, then use a fresh prefix")
    keys = aws.call("ec2", "describe-key-pairs", filters=filters(**{"key-name": args.prefix}))["KeyPairs"]
    if keys:
        raise ValueError("SSH key-pair name already exists; inspect it and choose a fresh resource prefix")
    return {"AccountId": identity["Account"], "PrincipalArn": identity["Arn"], "Region": args.region,
            "Prefix": args.prefix, "Scenario": args.scenario, "Inference": args.inference,
            "SshAccess": args.ssh_access,
            "HttpsAccess": args.https_access if args.scenario == "remote-gateway" else "disabled",
            "InstanceType": instance_type, "MemoryGiB": machine["MemoryInfo"]["SizeInMiB"] / 1024,
            "GpuInfo": machine.get("GpuInfo"), "AvailabilityZone": subnet["AvailabilityZone"],
            "Architecture": architecture, "ImageId": image["ImageId"], "ImageName": image["Name"],
            "RootDeviceName": image["RootDeviceName"], "SubnetId": args.subnet_id, "VpcId": subnet["VpcId"],
            "Ingress": rules, "VolumeGiB": args.volume_gib, "StateFile": str(args.state_file)}


def apply_plan(aws, args, proposal):
    state = {**proposal, "ClientToken": str(uuid.uuid4()), "ApplyStatus": "started"}
    save_state(args.state_file, state)
    print("Recovery journal:", args.state_file, flush=True)
    owned = tags(args.prefix, args.scenario)
    group = aws.call("ec2", "create-security-group", group_name=args.prefix, vpc_id=proposal["VpcId"],
                     description="Disposable secure-single-server VM; ingress as recorded in launch plan",
                     tag_specifications=[{"ResourceType": "security-group", "Tags": owned}])["GroupId"]
    print("Created security group:", group, flush=True)
    state.update(SecurityGroupId=group, ApplyStatus="security-group-created")
    update_state(args.state_file, state)
    aws.call("ec2", "authorize-security-group-ingress", group_id=group, ip_permissions=proposal["Ingress"])
    aws.call("ec2", "import-key-pair", key_name=args.prefix,
             public_key_material="fileb://" + str(args.public_key.resolve()),
             tag_specifications=[{"ResourceType": "key-pair", "Tags": owned}])
    state.update(KeyPairName=args.prefix, ApplyStatus="launch-requested")
    update_state(args.state_file, state)
    launch_instance(aws, args, proposal, state)


def launch_instance(aws, args, proposal, state):
    # Replay identical parameters with the recorded token after an uncertain result.
    owned = tags(args.prefix, args.scenario)
    try:
        result = aws.call("ec2", "run-instances", image_id=proposal["ImageId"],
            instance_type=proposal["InstanceType"], count=1, client_token=state["ClientToken"], key_name=state["KeyPairName"],
            network_interfaces=[{"DeviceIndex": 0, "SubnetId": args.subnet_id,
                                 "AssociatePublicIpAddress": True, "DeleteOnTermination": True,
                                 "Groups": [state["SecurityGroupId"]]}],
            metadata_options={"HttpTokens": "required", "HttpEndpoint": "enabled", "HttpPutResponseHopLimit": 1},
            block_device_mappings=[{"DeviceName": proposal["RootDeviceName"], "Ebs": {
                "Encrypted": True, "VolumeSize": args.volume_gib, "VolumeType": "gp3", "DeleteOnTermination": True}}],
            tag_specifications=[{"ResourceType": kind, "Tags": owned} for kind in ["instance", "volume"]])
    except AwsError as error:
        if error.code == "InsufficientInstanceCapacity":
            state["ApplyStatus"] = "capacity-unavailable"
            update_state(args.state_file, state)
        raise
    instance_id = result["Instances"][0]["InstanceId"]
    print("Launched instance:", instance_id, flush=True)
    state.update(InstanceId=instance_id, ApplyStatus="complete")
    update_state(args.state_file, state)
    print("State saved. Run verify after boot. On any failure inspect tagged resources; none are deleted automatically.")


@contextmanager
def deployment_lock(path):
    """Serialize applies across confirmation, reconciliation and journal updates."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(str(path) + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("another deployment is using this journal; wait for it to finish") from None
        yield
    finally:
        os.close(fd)


def retry_state(args):
    if args.state_file.is_symlink():
        raise ValueError("refusing a symlink journal")
    state = json.loads(args.state_file.read_text())
    if not isinstance(state, dict):
        raise ValueError("incomplete journal: expected a JSON object")
    if state.get("InstanceId") or state.get("ApplyStatus") == "complete":
        raise ValueError(f"VM already recorded: {state.get('InstanceId', 'unknown')}; use aws_test_verify, not deploy")
    required = ("AccountId", "Region", "Prefix", "Scenario", "Inference", "Architecture", "InstanceType",
                "ImageId", "RootDeviceName", "SubnetId", "VpcId", "AvailabilityZone", "VolumeGiB",
                "Ingress", "ClientToken", "SecurityGroupId", "KeyPairName")
    if state.get("ApplyStatus") not in ("launch-requested", "capacity-unavailable") or any(k not in state for k in required):
        raise ValueError("incomplete journal before instance launch; inspect recorded resources before recovery")
    expected = {"AccountId": args.account_id, "Region": args.region, "Prefix": args.prefix,
                "Scenario": args.scenario, "Inference": args.inference, "InstanceType": args.instance_type,
                "Architecture": "arm64" if args.arch == "arm64" else "x86_64", "VolumeGiB": args.volume_gib,
                "Ingress": ingress(args.scenario, args.allowed_cidr, args.ssh_access, args.https_access),
                "KeyPairName": args.prefix}
    if any(state[k] != value for k, value in expected.items()) or (args.ami_id and args.ami_id != state["ImageId"]):
        raise ValueError("retry must keep the recorded account, role, hardware, AMI, disk and access settings")
    if args.subnet_id != state["SubnetId"] and state["ApplyStatus"] != "capacity-unavailable":
        raise ValueError("previous launch outcome is uncertain; retry the original subnet first with the same client token")
    return state


def check_ingress(group, state, *, require_managed_grants=True):
    managed_grants = set(state.get("ManagedGrants", []))
    observed_grants = set()
    normalized = []
    for permission in group["IpPermissions"]:
        pairs = permission.get("UserIdGroupPairs", [])
        if pairs:
            pair_groups = {item.get("GroupId") for item in pairs}
            grant_matches = (bool(pair_groups) and pair_groups <= managed_grants and
                             permission.get("IpProtocol") == "tcp" and
                              permission.get("FromPort") == VLLM_PORT and
                              permission.get("ToPort") == VLLM_PORT)
            if (grant_matches and not permission.get("IpRanges") and not permission.get("Ipv6Ranges")
                    and not permission.get("PrefixListIds")):
                observed_grants.update(pair_groups)
                continue
            raise ValueError("unexpected non-IPv4 ingress")
        if permission.get("Ipv6Ranges") or permission.get("PrefixListIds"):
            raise ValueError("unexpected non-IPv4 ingress")
        normalized.append({key: permission[key] for key in ["IpProtocol", "FromPort", "ToPort", "IpRanges"]})
    if sorted(normalized, key=lambda rule: rule["FromPort"]) != state["Ingress"]:
        raise ValueError("security-group ingress differs from the recorded plan")
    if require_managed_grants and managed_grants != observed_grants:
        raise ValueError("managed vLLM grants differ from the recorded journal")


def check_owned(resource, state):
    actual = {item["Key"]: item["Value"] for item in resource.get("Tags", [])}
    if any(actual.get(item["Key"]) != item["Value"] for item in tags(state["Prefix"], state["Scenario"])):
        raise ValueError("retry resource ownership tags differ from the journal")


def retry_plan(aws, args, state):
    check_identity(aws, args.account_id)
    tokens = [state["ClientToken"], *[item["ClientToken"] for item in state.get("PreviousAttempts", [])]]
    instances = {}
    for query in (filters(**{"tag:ResourcePrefix": args.prefix}), [{"Name": "client-token", "Values": tokens}]):
        found = aws.call("ec2", "describe-instances", filters=query)
        instances.update({item["InstanceId"]: item for row in found["Reservations"] for item in row["Instances"]})
    if len(instances) > 1:
        raise ValueError("multiple instances match this journal; inspect them before any retry")
    if instances:
        instance = next(iter(instances.values()))
        check_owned(instance, state)
        if (instance.get("ClientToken") != state["ClientToken"] or instance.get("ImageId") != state["ImageId"]
                or instance.get("InstanceType") != state["InstanceType"] or instance.get("SubnetId") != state["SubnetId"]):
            raise ValueError("existing instance differs from the recorded launch; inspect before retrying")
        return {**state, "RecoveredInstanceId": instance["InstanceId"], "Action": "recover existing instance; no launch"}
    image = aws.call("ec2", "describe-images", image_ids=[state["ImageId"]])["Images"][0]
    validate_image(image, state["Architecture"])
    subnet = aws.call("ec2", "describe-subnets", subnet_ids=[args.subnet_id])["Subnets"][0]
    if (subnet["State"] != "available" or subnet["VpcId"] != state["VpcId"]
            or subnet["OwnerId"] != args.account_id or subnet["AvailableIpAddressCount"] < 1):
        raise ValueError("retry needs an available subnet with free IPs in the recorded VPC/account")
    check_offering(aws, state["InstanceType"], subnet["AvailabilityZone"])
    tables = aws.call("ec2", "describe-route-tables", filters=filters(**{"association.subnet-id": args.subnet_id}))["RouteTables"]
    if not tables:
        tables = aws.call("ec2", "describe-route-tables", filters=filters(
            **{"vpc-id": subnet["VpcId"], "association.main": "true"}))["RouteTables"]
    if not any(route.get("DestinationCidrBlock") == "0.0.0.0/0" and route.get("GatewayId", "").startswith("igw-")
               and route.get("State") == "active" for table in tables for route in table["Routes"]):
        raise ValueError("retry subnet needs an active IPv4 internet-gateway route")
    group = aws.call("ec2", "describe-security-groups", group_ids=[state["SecurityGroupId"]])["SecurityGroups"][0]
    check_owned(group, state)
    if group["VpcId"] != state["VpcId"] or group["GroupName"] != args.prefix:
        raise ValueError("retry security group differs from the journal")
    check_ingress(group, state)
    key = aws.call("ec2", "describe-key-pairs", key_names=[state["KeyPairName"]], include_public_key=True)["KeyPairs"][0]
    check_owned(key, state)
    if key["PublicKey"].split()[:2] != args.public_key.read_text().split()[:2]:
        raise ValueError("retry public key differs from the imported key; restore the original SSH_KEY")
    return {**state, "SubnetId": args.subnet_id, "AvailabilityZone": subnet["AvailabilityZone"],
            "Action": "retry instance launch; reuse security group and key pair"}


def apply_retry(aws, args, state, proposal):
    updated = {**proposal}
    updated.pop("Action", None)
    recovered = updated.pop("RecoveredInstanceId", None)
    if recovered:
        updated.update(InstanceId=recovered, ApplyStatus="complete")
        update_state(args.state_file, updated)
        print("Recovered existing instance:", recovered, "— run verify; no AWS resources changed.")
        return
    if proposal["SubnetId"] != state["SubnetId"]:
        updated["PreviousAttempts"] = [*state.get("PreviousAttempts", []), {
            "ClientToken": state["ClientToken"], "SubnetId": state["SubnetId"],
            "AvailabilityZone": state["AvailabilityZone"], "ApplyStatus": state["ApplyStatus"]}]
        updated["ClientToken"] = str(uuid.uuid4())
    updated["ApplyStatus"] = "launch-requested"
    update_state(args.state_file, updated)
    launch_instance(aws, args, proposal, updated)


def verify(aws, args):
    check_identity(aws, args.account_id)
    state = json.loads(args.state_file.read_text())
    if state["AccountId"] != args.account_id or state["Region"] != args.region:
        raise ValueError("state file account/region does not match the explicitly selected target")
    if "InstanceId" not in state:
        raise ValueError("incomplete apply journal; inspect resource-prefix tags and ClientToken before retrying")
    instance = aws.call("ec2", "describe-instances", instance_ids=[state["InstanceId"]])["Reservations"][0]["Instances"][0]
    actual_tags = {item["Key"]: item["Value"] for item in instance.get("Tags", [])}
    if any(actual_tags.get(item["Key"]) != item["Value"] for item in tags(state["Prefix"], state["Scenario"])):
        raise ValueError("instance ownership/scenario tags do not match")
    if instance["ImageId"] != state["ImageId"] or instance["InstanceType"] != state["InstanceType"]:
        raise ValueError("instance image/type differs from the recorded plan")
    image = aws.call("ec2", "describe-images", image_ids=[instance["ImageId"]])["Images"][0]
    validate_image(image, state["Architecture"])
    metadata = instance["MetadataOptions"]
    if (metadata["HttpTokens"] != "required" or metadata["HttpPutResponseHopLimit"] != 1
            or metadata["HttpEndpoint"] != "enabled" or instance.get("IamInstanceProfile")):
        raise ValueError("unexpected metadata policy or IAM instance profile")
    if [group["GroupId"] for group in instance["SecurityGroups"]] != [state["SecurityGroupId"]]:
        raise ValueError("unexpected attached security groups")
    group = aws.call("ec2", "describe-security-groups", group_ids=[state["SecurityGroupId"]])["SecurityGroups"][0]
    group_tags = {item["Key"]: item["Value"] for item in group.get("Tags", [])}
    if any(group_tags.get(item["Key"]) != item["Value"] for item in tags(state["Prefix"], state["Scenario"])):
        raise ValueError("security-group ownership/scenario tags do not match")
    check_ingress(group, state)
    interfaces = instance.get("NetworkInterfaces", [])
    if len(interfaces) != 1 or not interfaces[0].get("Attachment", {}).get("DeleteOnTermination"):
        raise ValueError("expected one network interface with deletion on termination")
    if len(instance["BlockDeviceMappings"]) != 1:
        raise ValueError("unexpected extra disks; termination-only cleanup is no longer assured")
    root = next(item for item in instance["BlockDeviceMappings"] if item["DeviceName"] == state["RootDeviceName"])
    volume = aws.call("ec2", "describe-volumes", volume_ids=[root["Ebs"]["VolumeId"]])["Volumes"][0]
    if not volume["Encrypted"] or not root["Ebs"]["DeleteOnTermination"] or volume["Size"] < state["VolumeGiB"]:
        raise ValueError("unexpected root-disk encryption, size or deletion policy")
    print(json.dumps({"InstanceId": instance["InstanceId"], "State": instance["State"]["Name"],
                      "PublicIpAddress": instance.get("PublicIpAddress"), "VpcId": instance.get("VpcId"),
                      "Scenario": state["Scenario"],
                      "Inference": state.get("Inference", "none"), "InstanceType": state["InstanceType"],
                      "SshAccess": state.get("SshAccess", "restricted"),
                      "HttpsAccess": state.get("HttpsAccess", "restricted" if state["Scenario"] == "remote-gateway" else "disabled"),
                      "VolumeGiB": volume["Size"],
                      "Result": "AWS configuration verified; SSH, host firewall and gateway tests remain separate"}, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["plan", "apply", "verify", "capacity", "vllm-endpoint", "vllm-grant"],
                        nargs="?", default="plan")
    parser.add_argument("--region", required=True)
    parser.add_argument("--account-id", required=True)
    parser.add_argument("--profile")
    parser.add_argument("--state-file", type=Path)
    parser.add_argument("--client-state-file", type=Path)
    parser.add_argument("--vllm-state-file", type=Path)
    parser.add_argument("--vllm-prefix")
    parser.add_argument("--vllm-instance-id")
    parser.add_argument("--client-vpc-id")
    parser.add_argument("--apply", action="store_true",
                        help="with vllm-grant, require typed confirmation and create the source-group rule")
    parser.add_argument("--config", type=Path, help="JSON VM settings; explicit flags override its values")
    parser.add_argument("--scenario", choices=SCENARIOS)
    parser.add_argument("--inference", choices=["none", "cpu", "gpu"], help="hardware profile, not an application install")
    parser.add_argument("--prefix")
    parser.add_argument("--subnet-id")
    parser.add_argument("--public-key", type=Path)
    parser.add_argument("--allowed-cidr")
    parser.add_argument("--ssh-access", choices=["restricted", "public"],
                        help="restricted (default): SSH from --allowed-cidr; public: SSH from any IPv4")
    parser.add_argument("--https-access", choices=["restricted", "public"],
                        help="remote-gateway only: restricted (default) from --allowed-cidr; public from any IPv4")
    parser.add_argument("--arch", choices=["amd64", "arm64"])
    parser.add_argument("--instance-type")
    parser.add_argument("--ami-id")
    parser.add_argument("--volume-gib", type=int)
    args = parser.parse_args()
    if not re.fullmatch(r"\d{12}", args.account_id):
        raise ValueError("account-id must be the expected 12-digit account, obtained independently")
    access, secret = os.environ.get("AWS_ACCESS_KEY_ID"), os.environ.get("AWS_SECRET_ACCESS_KEY")
    if bool(access) != bool(secret):
        raise ValueError("both AWS access-key variables must be set, or both unset")
    if access and (args.profile or os.environ.get("AWS_PROFILE") or os.environ.get("AWS_DEFAULT_PROFILE")):
        raise ValueError("do not mix exported AWS keys and a profile")
    aws = Aws(args.region, args.profile, False)
    if args.mode == "capacity":
        if not args.instance_type or not re.fullmatch(r"[a-z0-9]+\.[a-z0-9]+", args.instance_type) or not args.subnet_id:
            raise ValueError("capacity needs --instance-type and --subnet-id")
        print(json.dumps(capacity_report(aws, args), indent=2))
        return
    if args.mode == "vllm-endpoint":
        vllm_endpoint(aws, args)
        return
    if args.mode == "vllm-grant":
        if not args.client_state_file or not args.vllm_state_file:
            raise ValueError("vllm-grant needs --client-state-file and --vllm-state-file")
        with deployment_lock(args.vllm_state_file) if args.apply else nullcontext():
            vllm_grant(aws, args)
        return
    if not args.state_file:
        parser.error("--state-file is required for plan/apply/verify")
    if args.mode == "verify":
        verify(aws, args)
        return
    if not args.config:
        raise ValueError("plan/apply require --config; reload shell helpers with 'source scripts/aws/session.sh', "
                         "then use aws_test_plan NAME CONFIG --scenario ROLE (one VM per call)")
    configure(args)
    if not all([args.scenario, args.prefix, args.subnet_id, args.public_key]):
        raise ValueError("plan/apply need a scenario, --prefix, --subnet-id and --public-key")
    if not re.fullmatch(r"[a-z][a-z0-9-]{2,39}", args.prefix) or args.volume_gib < 50:
        raise ValueError("prefix must be 3-40 lowercase letters/digits/hyphens; disk must be at least 50 GiB")
    with deployment_lock(args.state_file) if args.mode == "apply" else nullcontext():
        execute_plan(aws, args)


def execute_plan(aws, args):
    state = retry_state(args) if args.state_file.exists() or args.state_file.is_symlink() else None
    proposal = retry_plan(aws, args, state) if state else plan(aws, args)
    print(json.dumps(proposal, indent=2))
    if state:
        print("Recovery plan:", proposal["Action"], "— existing journal retained.")
    else:
        print("Plan: one on-demand VM, encrypted root disk, imported PUBLIC key and security group."
              " Default security-group IPv4 egress is unrestricted. No IAM/SSM or application install.")
    if args.ssh_access == "public":
        print("Public SSH selected: anyone on the IPv4 Internet can reach port 22."
              " SSH authentication still applies.")
    if args.scenario == "remote-gateway":
        if args.https_access == "public":
            print("Public HTTPS selected: anyone on the IPv4 Internet can reach port 8443."
                  " Install the HTTPS/JWT gateway before serving requests; valid caller JWTs remain required.")
        else:
            print("HTTPS 8443 remains restricted to", args.allowed_cidr)
    if args.inference == "cpu":
        print("CPU inference: verify AVX-512 on the host before installing the pinned vLLM image."
              " 64 GiB RAM is recommended; inference will be slower than GPU.")
    elif args.inference == "gpu":
        print("GPU inference: install and verify the NVIDIA driver and container toolkit on RHEL before vLLM."
              " AWS hardware verification does not prove driver/model readiness.")
    if args.mode == "plan":
        print("Read-only plan complete: no AWS resource or local state file was changed.")
        return
    action = "recover" if proposal.get("RecoveredInstanceId") else "launch"
    confirmation = f"{action} {args.account_id} {args.region} {args.prefix}"
    notice = "Recover existing instance journal." if action == "recover" else "Billable instance launch."
    if input(notice + " Type exactly '" + confirmation + "': ") != confirmation:
        raise ValueError("confirmation did not match; no changes made")
    aws.apply = True
    if state:
        # Repeat reconciliation after the operator has reviewed the plan.
        proposal = retry_plan(aws, args, state)
        apply_retry(aws, args, state, proposal)
    else:
        apply_plan(aws, args, proposal)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, IndexError, subprocess.CalledProcessError) as error:
        print("error: " + str(error), file=sys.stderr)
        print("No automatic cleanup. If apply started, inspect the printed IDs and resource-prefix tags.", file=sys.stderr)
        sys.exit(1)
