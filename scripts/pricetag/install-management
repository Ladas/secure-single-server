#!/usr/bin/env python3
"""Install the private gateway-management adapter on an existing deployment.

Inputs contain configuration and Podman secret references, never key values.
The candidate PriceTag image must support GATEWAY_MANAGEMENT_SOCKET.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import pwd
import secrets
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'scripts/common'))
from gateway_management import validate
from gateway_management_backend import Backend

DEPLOY = Path('/etc/praxis-pricetag')
INSTALL = Path('/opt/praxis-gateway-management')
RUNTIME = Path('/run/praxis-gateway-management')
FILES = ['scripts/pricetag/gateway-management-serve', 'scripts/pricetag/gateway_management.py',
         'scripts/pricetag/gateway_management_transport.py', 'scripts/pricetag/gateway_management_backend.py',
         'scripts/pricetag/gateway.py', 'scripts/pricetag/providers',
         'scripts/common/unified_config.py', 'scripts/common/provider_config.py',
         'configs/pricetag/provider-models.json',
         'configs/pricetag/selinux/praxis_gateway_management.te',
         'configs/pricetag/selinux/praxis_gateway_management.fc']


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--configuration', type=Path, required=True)
    parser.add_argument('--secret-references', type=Path, required=True)
    parser.add_argument('--approved-origin', action='append', required=True)
    parser.add_argument('--mock', action='store_true')
    parser.add_argument('--resume', action='store_true', help='resume the same configuration after an interrupted installation')
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run with sudo on the gateway host')
    if not (DEPLOY / 'bootstrap.done').is_file():
        parser.error('requires a started gateway deployment')
    if args.mock and not (DEPLOY / 'quadlets/pricetag-provider.container').is_file():
        parser.error('mock option requires the dedicated mock-provider deployment')
    if not args.mock and any(not x.startswith('https://') for x in args.approved_origin):
        parser.error('production provider origins require HTTPS')
    document = validate(json.loads(args.configuration.read_text()), args.approved_origin)
    references = json.loads(args.secret_references.read_text())
    import re
    if (not isinstance(references, dict) or set(references) != {p['name'] for p in document['providers']}
            or any(not isinstance(v, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+', v) for v in references.values())):
        parser.error('each provider requires one valid Podman secret reference')
    initialized = (DEPLOY / 'gateway-management.json').exists()
    if initialized:
        if not args.resume:
            parser.error('adapter already initialized; use its API or --resume for an interrupted install')
        expected = {'approved_origins': args.approved_origin, 'mock': args.mock}
        if (json.loads((DEPLOY / 'gateway-management.json').read_text()) != document or
                json.loads((DEPLOY / 'provider-secret-refs.json').read_text()) != references or
                json.loads((DEPLOY / 'gateway-management-policy.json').read_text()) != expected):
            parser.error('resume inputs differ from existing state; use the management API')
    owner = pwd.getpwnam('praxis-svc')
    service = ['sudo', '-u', 'praxis-svc', 'env', f'XDG_RUNTIME_DIR=/run/user/{owner.pw_uid}',
               f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{owner.pw_uid}/bus']
    for name in references.values():
        subprocess.run([*service, 'podman', 'secret', 'exists', name], cwd='/tmp', check=True)
    os.umask(0o077)
    for relative in FILES:
        source, destination = ROOT / relative, INSTALL / relative
        if source.is_symlink() or not source.is_file():
            raise ValueError('expected a regular source file')
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
        if destination.is_symlink():
            raise ValueError('unexpected installed symlink')
        shutil.copyfile(source, destination)
        destination.chmod(0o755 if relative.endswith('/gateway-management-serve') else 0o644)
    policy = {'approved_origins': args.approved_origin, 'mock': args.mock}
    for name, value in [('gateway-management.json', document), ('provider-secret-refs.json', references),
                        ('gateway-management-policy.json', policy)]:
        (DEPLOY / name).write_text(json.dumps(value, indent=2) + '\n')
        (DEPLOY / name).chmod(0o600)
    capability = (DEPLOY / 'gateway-management-secret').read_text().strip() if initialized else secrets.token_urlsafe(48)
    (DEPLOY / 'gateway-management-secret').write_text(capability + '\n')
    (DEPLOY / 'gateway-management-secret').chmod(0o600)
    loader = importlib.machinery.SourceFileLoader('provider_helpers', str(INSTALL / 'scripts/pricetag/providers'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    helpers = importlib.util.module_from_spec(spec); loader.exec_module(helpers)
    helpers.STATE.mkdir(mode=0o700, exist_ok=True)
    backend = Backend(helpers)
    with backend.lock():
        backend.activate(document, {})
    env = DEPLOY / 'metering.env'
    lines = [x for x in env.read_text().splitlines() if not x.startswith(('GATEWAY_MANAGEMENT_SOCKET=', 'GATEWAY_MANAGEMENT_SECRET='))]
    lines += ['GATEWAY_MANAGEMENT_SOCKET=/run/gateway-management/adapter.sock', 'GATEWAY_MANAGEMENT_SECRET=' + capability]
    env.write_text('\n'.join(lines) + '\n')
    mount = f'Volume={RUNTIME}:/run/gateway-management:rw'
    for unit in [DEPLOY / 'quadlets/pricetag-metering.container', Path('/etc/containers/systemd/users') / str(owner.pw_uid) / 'pricetag-metering.container']:
        body = unit.read_text()
        if mount not in body:
            unit.write_text(body.replace('[Container]\n', '[Container]\n' + mount + '\n', 1))
    unit = f'''[Unit]
Description=Private Praxis gateway configuration adapter
After=network-online.target user@{owner.pw_uid}.service
[Service]
Type=simple
RuntimeDirectory=praxis-gateway-management
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/restorecon -R {RUNTIME}
ExecStart={INSTALL}/scripts/pricetag/gateway-management-serve
Restart=on-failure
RestartSec=2
UMask=0077
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
[Install]
WantedBy=multi-user.target
'''
    target = Path('/etc/systemd/system/praxis-gateway-management.service')
    target.write_text(unit); target.chmod(0o644)
    context = '/var/run/praxis-gateway-management(/.*)?'
    result = subprocess.run(['semanage', 'fcontext', '-a', '-t', 'container_file_t', context], capture_output=True)
    if result.returncode:
        subprocess.run(['semanage', 'fcontext', '-m', '-t', 'container_file_t', context], check=True)
    policy_directory = INSTALL / 'configs/pricetag/selinux'
    subprocess.run(['make', '-f', '/usr/share/selinux/devel/Makefile', 'praxis_gateway_management.pp'], cwd=policy_directory, check=True)
    subprocess.run(['semodule', '-i', str(policy_directory / 'praxis_gateway_management.pp')], check=True)
    subprocess.run(['restorecon', str(INSTALL / 'scripts/pricetag/gateway-management-serve')], check=True)
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', 'enable', 'praxis-gateway-management.service'], check=True)
    subprocess.run(['systemctl', 'restart', 'praxis-gateway-management.service'], check=True)
    subprocess.run([*service, 'systemctl', '--user', 'daemon-reload'], cwd='/tmp', check=True)
    subprocess.run([*service, 'systemctl', '--user', 'restart', 'pricetag-metering.service'], cwd='/tmp', check=True)
    print('Gateway-management candidate installed. Verify the administrator UI and rejected unauthorized requests.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError):
        raise SystemExit('Management installation stopped; inspect service status and preserved configuration. No credentials printed.') from None
