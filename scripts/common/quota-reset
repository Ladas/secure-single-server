#!/usr/bin/env bash
# Reset explicitly selected persistent quotas for testing.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/lib.sh"
if [[ "${1:-}" == --help || "$#" == 0 ]]; then
  python3 "${SCRIPT_DIR}/quota_reset.py" --help
  exit 0
fi
require_root
require_command flock
exec 9>"$(gateway_lock_path "${SERVICE_USER}")"
flock -n 9 || die 'another gateway change is running'
verify_managed_manifest
python3 "${SCRIPT_DIR}/quota_reset.py" "$@"
