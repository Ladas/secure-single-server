#!/usr/bin/env bash
# Change one provider while retaining the gateway's identity and quota state.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/common/lib.sh
source "${SCRIPT_DIR}/lib.sh"
if [[ "${1:-}" == --help || "$#" == 0 ]]; then
  python3 "${SCRIPT_DIR}/provider_manage.py" --help
  exit 0
fi
require_root
require_command flock
exec 9>/run/lock/praxis-gateway.lock
flock -n 9 || die 'another gateway installation/provider change is running'
verify_managed_manifest
python3 "${SCRIPT_DIR}/provider_manage.py" "$@"
