# Mutable RHEL preset. Quantized weights; thinking remains enabled.
# https://huggingface.co/RedHatAI/Qwen3.8-27B-INT4
VLLM_MODEL=RedHatAI/Qwen3.8-27B-INT4
VLLM_REVISION=91bd022d5b49442a868bc35008f6c21e1860edfa
VLLM_TOOL_PARSER=qwen3_xml
