[Unit]
Description=Secure single-server Praxis gateway
After=network-online.target
Wants=network-online.target

[Container]
Image=@@PRAXIS_IMAGE@@
ContainerName=praxis-shared-gateway
Pull=never
User=1001
Group=1001
UserNS=keep-id:uid=1001,gid=1001
# Host networking reaches the separate vllm-svc loopback publication.
# The matching local configuration binds every listener to loopback.
Network=host
Volume=/etc/praxis/shared-gateway.yaml:/etc/praxis/shared-gateway.yaml:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
HealthOnFailure=kill
Exec=-c /etc/praxis/shared-gateway.yaml

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
