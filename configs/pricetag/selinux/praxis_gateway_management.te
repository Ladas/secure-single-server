policy_module(praxis_gateway_management, 1.0.0)

# This host administrator service already requires privileged access to fixed
# gateway files and rootless Podman. Give it a distinct domain so container
# connection permission does not cover other unconfined host services.
type praxis_gateway_management_t;
type praxis_gateway_management_exec_t;
init_daemon_domain(praxis_gateway_management_t, praxis_gateway_management_exec_t)
unconfined_domain(praxis_gateway_management_t)

gen_require(`
    type container_t;
')

# File access still requires the explicitly mounted socket directory; the
# adapter additionally checks its dedicated capability on every request.
allow container_t praxis_gateway_management_t:unix_stream_socket connectto;
