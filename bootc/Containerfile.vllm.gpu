ARG RHEL_BOOTC_IMAGE
ARG RHSM=0
FROM ${RHEL_BOOTC_IMAGE}
ARG RHSM
COPY bootc/install-nvidia /tmp/install-nvidia

RUN --mount=type=secret,id=rhsm_org,target=/run/secrets/rhsm_org \
    --mount=type=secret,id=rhsm_activation_key,target=/run/secrets/rhsm_activation_key \
    set -eu; \
    registered=0; \
    rhsm_cleanup() { \
      if [ "${registered}" = 1 ]; then \
        subscription-manager unregister; \
        subscription-manager clean; \
      fi; \
    }; \
    trap 'rhsm_cleanup || true' EXIT; \
    if [ "${RHSM}" = 1 ]; then \
      org="$(cat /run/secrets/rhsm_org)"; \
      activation_key="$(cat /run/secrets/rhsm_activation_key)"; \
      subscription-manager register --org "${org}" --activationkey "${activation_key}"; \
      registered=1; \
    fi; \
    dnf install -y podman policycoreutils-python-utils shadow-utils util-linux \
      curl cloud-init; \
    bash /tmp/install-nvidia; \
    rm -f /tmp/install-nvidia; \
    rhsm_cleanup; \
    trap - EXIT; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/lib/dnf /var/lib/rhsm /run/cloud-init /run/rhsm; \
    find /var/log -type f -delete

COPY scripts/common/lib.sh /usr/share/secure-single-server/scripts/common/lib.sh
COPY scripts/common/install /usr/share/secure-single-server/scripts/common/install
COPY bootc/scripts/vllm-common /usr/share/secure-single-server/bootc/scripts/vllm-common
COPY bootc/scripts/vllm /usr/share/secure-single-server/bootc/scripts/vllm
COPY bootc/scripts/vllm-lib /usr/share/secure-single-server/bootc/scripts/vllm-lib
COPY bootc/vllm-profile /usr/share/secure-single-server/bootc/vllm-profile
COPY configs/vllm/images.env /usr/share/secure-single-server/configs/vllm/images.env
COPY bootc/systemd/secure-single-server-vllm.service /usr/lib/systemd/system/
COPY bootc/systemd/delegate.conf /usr/lib/systemd/system/user@.service.d/50-secure-single-server.conf
RUN chmod 0755 /usr/share/secure-single-server/bootc/scripts/vllm-common \
      /usr/share/secure-single-server/bootc/scripts/vllm \
      /usr/share/secure-single-server/bootc/scripts/vllm-lib \
    && ln -s /usr/share/secure-single-server/bootc/scripts/vllm /usr/bin/sss-vllm \
    && systemctl enable secure-single-server-vllm.service \
    && bootc container lint

LABEL containers.bootc=1
