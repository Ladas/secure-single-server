#!/usr/bin/env bash
# Sourced after bootc/scripts/common. Pins belong to the OS deployment.
# shellcheck disable=SC1091
source "${ROOT}/configs/vllm/images.env"

vllm_mode() {
  local mode=disabled
  if [[ -f /etc/secure-single-server/vllm-mode ]]; then
    mode="$(cat /etc/secure-single-server/vllm-mode)"
  fi
  case "${mode}" in disabled|cpu|gpu) ;; *) die 'invalid vllm-mode; expected disabled, cpu, or gpu' ;; esac
  printf '%s\n' "${mode}"
}

vllm_image() {
  case "$1" in
    cpu) printf '%s\n' "${VLLM_CPU_IMAGE}" ;;
    gpu) printf '%s\n' "${VLLM_GPU_IMAGE}" ;;
    *) die 'expected cpu or gpu' ;;
  esac
}

vllm_image_profile() {
  local profile
  profile="$(<"${ROOT}/bootc/vllm-profile")"
  case "${profile}" in cpu|gpu|any) ;; *) die 'invalid vLLM image profile' ;; esac
  printf '%s\n' "${profile}"
}

vllm_preflight() {
  [[ "$(uname -m)" == x86_64 ]] || die 'vLLM profiles require x86_64'
  if [[ "$1" != disabled ]]; then
    local image_profile
    image_profile="$(vllm_image_profile)"
    [[ "${image_profile}" == any || "$1" == "${image_profile}" ]] ||
      die "this ${image_profile} vLLM image supports only ${image_profile} mode"
  fi
  case "$1" in
    cpu)
      grep -qw avx512f /proc/cpuinfo || die 'CPU profile requires AVX-512'
      awk '/MemTotal/ {exit ($2 < 32000000)}' /proc/meminfo || die 'CPU profile requires at least 32 GB RAM; 64 GiB recommended'
      ;;
    gpu)
      require_command nvidia-smi
      require_command nvidia-ctk
      [[ "$(nvidia-smi --query-gpu=name --format=csv,noheader)" == 'NVIDIA L4' ]] || die 'GPU profile requires exactly one NVIDIA L4'
      ;;
    disabled) ;;
    *) die 'expected disabled, cpu, or gpu' ;;
  esac
}

vllm_render() {
  local mode="$1" image extra
  image="$(vllm_image "${mode}")" || return
  validate_digest_image "${image}"
  extra='--gpu-memory-utilization 0.90'
  [[ "${mode}" != cpu ]] || extra=''
  cat <<UNIT
[Unit]
Description=Qwen3-8B vLLM (${mode})
After=network-online.target
Wants=network-online.target

[Container]
Image=${image}
ContainerName=vllm-qwen3
Pull=never
User=1001
Group=1001
UserNS=keep-id:uid=1001,gid=1001
PublishPort=0.0.0.0:8000:8000
Volume=%h/cache:/cache:Z
Environment=HOME=/cache HF_HOME=/cache/huggingface VLLM_CACHE_ROOT=/cache/vllm
Environment=VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1
NoNewPrivileges=true
DropCapability=all
ShmSize=4g
UNIT
  if [[ "${mode}" == cpu ]]; then
    # Avoid affinity/NUMA operations requiring additional host privileges.
    printf 'Environment=VLLM_CPU_KVCACHE_SPACE=4 VLLM_CPU_OMP_THREADS_BIND=nobind\n'
  else
    printf 'AddDevice=nvidia.com/gpu=0\nSecurityLabelDisable=true\n'
  fi
  cat <<UNIT
Exec=${VLLM_MODEL} --revision ${VLLM_REVISION} --host 0.0.0.0 --port 8000 --dtype bfloat16 --tensor-parallel-size 1 --max-model-len 16384 --max-num-seqs 1 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3 --default-chat-template-kwargs '{"enable_thinking":false}' ${extra}

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
UNIT
}
