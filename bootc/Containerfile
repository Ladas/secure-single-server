ARG RHEL_BOOTC_IMAGE
ARG RHSM=0
FROM ${RHEL_BOOTC_IMAGE}
ARG RHSM

# Workload containers are pulled into persistent rootless storage after boot.
# Only the native CLI is copied into the OS image.
RUN --mount=type=secret,id=rhsm_org,target=/run/secrets/rhsm_org \
    --mount=type=secret,id=rhsm_activation_key,target=/run/secrets/rhsm_activation_key \
    set -eu; \
    registered=0; \
    rhsm_cleanup() { \
      if [ "${registered}" = 1 ]; then \
        subscription-manager unregister; \
        subscription-manager clean; \
      fi; \
    }; \
    trap 'rhsm_cleanup || true' EXIT; \
    if [ "${RHSM}" = 1 ]; then \
      org="$(cat /run/secrets/rhsm_org)"; \
      activation_key="$(cat /run/secrets/rhsm_activation_key)"; \
      subscription-manager register --org "${org}" --activationkey "${activation_key}"; \
      registered=1; \
    fi; \
    dnf install -y podman skopeo policycoreutils-python-utils shadow-utils \
    util-linux openssl openssh-clients jq python3 curl cloud-init; \
    rg_version=14.1.1; \
    rg_sha256=4cf9f2741e6c465ffdb7c26f38056a59e2a2544b51f7cc128ef28337eeae4d8e; \
    rg_archive="/tmp/ripgrep-${rg_version}-x86_64-unknown-linux-musl.tar.gz"; \
    curl --fail --show-error --silent --location --retry 3 --retry-all-errors \
      "https://github.com/BurntSushi/ripgrep/releases/download/${rg_version}/ripgrep-${rg_version}-x86_64-unknown-linux-musl.tar.gz" \
      -o "${rg_archive}"; \
    printf '%s  %s\n' "${rg_sha256}" "${rg_archive}" | sha256sum -c -; \
    tar -xzf "${rg_archive}" -C /tmp; \
    install -m 0755 "/tmp/ripgrep-${rg_version}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg; \
    rm -rf "${rg_archive}" "/tmp/ripgrep-${rg_version}-x86_64-unknown-linux-musl"; \
    /usr/local/bin/rg --version | grep -F "ripgrep ${rg_version}"; \
    rhsm_cleanup; \
    trap - EXIT; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/lib/dnf /var/lib/rhsm /run/cloud-init /run/rhsm; \
    find /var/log -type f -delete
COPY bootc/openshell /usr/bin/openshell
COPY scripts/common /usr/share/secure-single-server/scripts/common
COPY configs /usr/share/secure-single-server/configs
# Harness policy files and catalogs are installed together by the variant.
RUN rm -rf /usr/share/secure-single-server/configs/templates
COPY openshell/configs /usr/share/secure-single-server/openshell/configs
COPY openshell/scripts /usr/share/secure-single-server/openshell/scripts
COPY bootc/scripts /usr/share/secure-single-server/bootc/scripts
COPY bootc/vllm-profile /usr/share/secure-single-server/bootc/vllm-profile
COPY bootc/systemd/secure-single-server*.service /usr/lib/systemd/system/
COPY bootc/systemd/delegate.conf /usr/lib/systemd/system/user@.service.d/50-secure-single-server.conf
RUN chmod 0755 /usr/share/secure-single-server/bootc/scripts/* \
    && ln -s /usr/share/secure-single-server/bootc/scripts/admin /usr/bin/sss-bootc \
    && systemctl enable secure-single-server.service secure-single-server-vllm.service \
    && bootc container lint
LABEL containers.bootc=1
